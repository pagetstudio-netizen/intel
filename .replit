modules = ["rust-stable"]
[agent]
expertMode = true

[nix]
channel = "stable-25_05"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Build"

[[workflows.workflow]]
name = "Build"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd security-core && cargo build --release 2>&1 && echo '✅ Build successful. Binary: security-core/target/release/intel'"

[workflows.workflow.metadata]
outputType = "console"
