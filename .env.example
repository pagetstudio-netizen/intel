# ─── Database ───────────────────────────────────────────
# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/intel_db

# ─── Server ─────────────────────────────────────────────
PORT=3000
NODE_ENV=production

# ─── Email (optionnel — pour envoyer les rapports) ──────
# Option A : Resend (recommandé)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=noreply@votredomaine.com

# Option B : Gmail SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=votre@gmail.com
SMTP_PASS=votre_app_password

# ─── Sécurité ────────────────────────────────────────────
# Clé secrète pour JWT (générez avec: openssl rand -hex 32)
JWT_SECRET=changez_moi_avec_une_valeur_aleatoire_longue

# ─── Frontend (si servi séparément) ──────────────────────
VITE_API_URL=https://api.votredomaine.com
